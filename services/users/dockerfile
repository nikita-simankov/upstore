FROM golang:1.26.3-alpine AS builder

ARG SERVICE_NAME=users
ARG SERVICE_PATH=services/users
ARG BUILD_VERSION=dev

RUN apk add --no-cache git ca-certificates tzdata

WORKDIR /build

COPY go.work go.work.sum* ./
COPY shared/go.mod shared/go.sum* ./shared/
COPY proto/generated/go.mod proto/generated/go.sum* ./proto/generated/
COPY services/${SERVICE_NAME}/go.mod services/${SERVICE_NAME}/go.sum* ./services/${SERVICE_NAME}/

RUN go work sync

COPY shared/ ./shared/
COPY proto/generated/ ./proto/generated/
COPY services/${SERVICE_NAME}/ ./services/${SERVICE_NAME}/

RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build \
        -trimpath \
        -ldflags="-s -w -X main.version=${BUILD_VERSION}" \
        -o /build/bin/${SERVICE_NAME} \
        ./services/${SERVICE_NAME}/cmd/main.go

FROM alpine:3.19 AS runtime

RUN apk add --no-cache ca-certificates tzdata

RUN addgroup -S -g 1000 upstore && \
    adduser -S -u 1000 -G upstore -h /app upstore

WORKDIR /app

COPY --from=builder --chown=upstore:upstore /build/bin/${SERVICE_NAME} ./app

COPY --from=builder --chown=upstore:upstore /build/services/${SERVICE_NAME}/migrations ./migrations

USER upstore

EXPOSE 50051 9090

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD wget -q --spider http://localhost:9090/health || exit 1

ENTRYPOINT ["./app"]